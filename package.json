{
  "name": "flow-store",
  "private": true,
  "description": "KaiStore monorepo — scripts de desarrollo",
  "scripts": {
    "dev": "bash scripts/dev-all.sh lite",
    "dev:all": "bash scripts/dev-all.sh all",
    "dev:lite": "bash scripts/dev-all.sh lite",
    "dev:eshop": "bash scripts/dev-all.sh eshop",
    "dev:san-sebastian": "bash scripts/dev-san-sebastian.sh",
    "setup:san-sebastian": "bash scripts/setup-san-sebastian-dev.sh",
    "setup:demo": "bash scripts/setup-demo-dev.sh",
    "dev:infra": "bash scripts/dev-infra.sh",
    "dev:apps": "bash scripts/dev-apps.sh lite",
    "dev:apps:all": "bash scripts/dev-apps.sh all",
    "dev:apps:eshop": "bash scripts/dev-apps.sh eshop",
    "env:dev": "bash envs/sync-dev-envs.sh --force",
    "kai-printers:publish": "node packages/kai-printers-release/scripts/publish-all.mjs",
    "kai-printers:publish:android": "bash kai-printers-android/scripts/publish-to-pos-downloads.sh",
    "kai-printers:publish:desktop": "node packages/kai-printers-release/scripts/publish-to-pos-downloads.mjs",
    "kai-printers-desktop:publish": "node packages/kai-printers-release/scripts/publish-to-pos-downloads.mjs",
    "kai-screen:publish": "bash kai-screen-android/scripts/publish-to-pos-downloads.sh",
    "brand:icons": "cd packages/kai-brand && npm install && npm run generate",
    "landing:dev": "npm run dev --prefix landing",
    "landing:build": "npm run build --prefix landing",
    "seed:demo": "npm run seed:demo --prefix seeds",
    "seed:joyarte": "npm run seed:joyarte --prefix seeds",
    "seed:san-sebastian": "npm run seed:san-sebastian --prefix seeds",
    "build:fiscal-ted": "npm run build --prefix packages/fiscal-ted"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
