# Local folders not to push
proyecto-reportes/
docs/
/scripts/
# Dependencies and build artifacts
node_modules/
**/node_modules/
packages/**/node_modules/
dist/
build/
**/dist/
**/build/
**/.vite/
**/.next/

# Local environment files
.env
.env.local
.env.production
.env.development
.env.test
kai-core/.env
kai-core/.env.local
envs/*.env
envs/*.env.local
envs/certs/
!envs/*.env.example
!envs/*.env.local.example
!envs/profiles/*.env.example
!envs/README.md

