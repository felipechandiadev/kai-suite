# kai-admin — fragmento (shared.env + este archivo → kai-admin/.env.local)
# NEXTAUTH_* ← ADMIN_NEXTAUTH_* | módulos ← KAI_FEATURE_* (sync)

NODE_ENV=development
BACKEND_API_URL=http://localhost:5060
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5060
# URL pública de kai-menu (QR en /kaifood/menu/qr)
NEXT_PUBLIC_KAI_MENU_URL=http://localhost:5370
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# NEXT_PUBLIC_KAI_PRINTERS_ANDROID_URL=

# Service worker en desarrollo (1 = registrar /sw.js)
NEXT_PUBLIC_SW_DEV=1
