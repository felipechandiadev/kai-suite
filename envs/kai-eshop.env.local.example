# kai-eshop — fragmento
# NEXT_PUBLIC_ESHOP_* ← shared.env

BACKEND_API_URL=http://localhost:5060
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5060
NEXT_PUBLIC_ESHOP_STORE_SLUG=
NEXT_PUBLIC_ESHOP_SITE_URL=

NEXT_PUBLIC_APP_NAME=KaiStore e-Shop
NEXT_PUBLIC_APP_VERSION=0.1.0

# Habilita checkout con reparto local (zonas, geocode, franjas)
NEXT_PUBLIC_ESHOP_DELIVERY_ADVANCED=true

# Service worker en desarrollo (1 = registrar /sw.js)
NEXT_PUBLIC_SW_DEV=1
