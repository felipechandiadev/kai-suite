# Backend — fragmento (valores de infra vienen de shared.env)
# Destino: kai-core/.env

# ==================== APPLICATION ====================
NODE_ENV=development
PORT=5060
API_PREFIX=api

# ==================== DATABASE ====================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# ==================== REDIS CACHE ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flow:
REDIS_TTL=3600
REDIS_CLUSTER_MODE=false

# ==================== JWT AUTHENTICATION ====================
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS_ORIGIN se genera en sync desde KAI_*_PORT + KAI_DEV_HOST
CORS_ORIGIN=
CORS_CREDENTIALS=true

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ==================== METRICS & MONITORING ====================
METRICS_ENABLED=true
METRICS_PREFIX=flow_backend
HEALTH_CHECK_ENABLED=true

# ==================== EXTERNAL APIs ====================
GOLD_API_URL=
GOLD_API_KEY=

# ==================== FILE UPLOAD ====================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# ==================== MULTIMEDIA STORAGE ====================
# STORAGE_STRATEGY desde shared.env (local | cloudflare)
STORAGE_STRATEGY=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
LOCAL_STORAGE_PATH=./public/uploads
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,application/pdf
MEDIA_PUBLIC_BASE_PATH=/multimedia/files

# ==================== SECURITY ====================
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==================== BUSINESS RULES ====================
MAX_TRANSACTION_LINES=100
DEFAULT_CURRENCY=COP
TIMEZONE=America/Bogota

# ==================== FEATURE FLAGS ====================
ENABLE_SWAGGER=true
ENABLE_CORS=true

# Kai Voice TTS (services/kai-voice). Vacío = fallback speechSynthesis (malo en TV).
KAI_VOICE_URL=http://localhost:5041
# Alias legacy (mismo valor):
LIRA_VOICE_URL=http://localhost:5041
ENABLE_HEALTH_CHECK=true
ENABLE_METRICS=true
ENABLE_CACHE=true
ESHOP_CHECKOUT_V2=true

# ==================== KAI MAIL ====================
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_API_KEY=dev-kai-mail-key

STOCK_THRESHOLD_SWEEP_MS=1800000
# Gastos operativos recurrentes (0 = desactivado; default en código 1h)
RECURRING_OE_WORKER_INTERVAL_MS=3600000
MP_WEBHOOK_SECRET=

# ==================== WEB PUSH (VAPID) ====================
# Generar: cd kai-core && npx web-push generate-vapid-keys
# Sin estas keys el push nativo queda deshabilitado (inbox/WS siguen OK).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@kai.local

# ==================== FISCAL / SII (matriz → shared.env) ====================
FISCAL_ENCRYPTION_KEY=
SAN_SEBASTIAN_SII_PFX_PASSWORD=

# Emisión asíncrona boleta POS (Fase B)
FISCAL_BOLETA_ASYNC_EMIT=true
FISCAL_EMISSION_WORKER_INTERVAL_MS=5000
FISCAL_EMISSION_WORKER_BATCH_SIZE=20
FISCAL_EMISSION_MAX_SUBMIT_ATTEMPTS=12
FISCAL_EMISSION_STALE_SENDING_MS=120000
FISCAL_EMISSION_SUBMIT_BACKOFF_BASE_MS=5000
