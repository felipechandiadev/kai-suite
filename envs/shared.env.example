# Kai — matriz de desarrollo (infra + manifiesto de deploy + secretos)
# Copiar a envs/shared.env para overrides locales (opcional; gitignored).
# Proyectada a cada app por envs/sync-dev-envs.sh + fragmentos *.example

# ==================== PLATAFORMA / DEPLOY ====================
# Vertical de producto: kaistore | kaifood | kaiservices | kaisuite
KAI_PRODUCT=kaisuite
# lite | eshop | retail-full | all  (usado por dev-apps si KAI_DEPLOY_APPS está vacío)
KAI_DEPLOY_PROFILE=all

# Módulos de ESTE despliegue (no por empresa en BD)
KAI_FEATURE_ESHOP=true
KAI_FEATURE_JEWELRY=true
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true

# Apps a levantar en dev/deploy (coma-separado). Suite: retail + food + eShop + waiter/kds
KAI_DEPLOY_APPS=backend,admin,pos,stock,eshop,delivery,waiter,kds,mail,landing

NODE_ENV=development
KAI_DEV_HOST=localhost

# Puertos frontends (506x — deben coincidir con package.json de cada app).
# Backend local en 5030: Next.js bloquea fetch server-side a 5060/5061 (sip/sips).
# En VPS/demo el backend usa 5060 (deploy/ports.demo.env.example).
KAI_BACKEND_PORT=5030
KAI_ADMIN_PORT=5071
KAI_POS_PORT=5062
KAI_STOCK_PORT=5063
KAI_ESHOP_PORT=5064
KAI_DELIVERY_PORT=5065
KAI_LANDING_PORT=5066
KAI_WAITER_PORT=5067
KAI_KDS_PORT=5068
KAI_MAIL_PORT=5040

# URLs derivadas (sync también las recalcula si cambias host/puertos)
KAI_BACKEND_URL=http://localhost:5030
BACKEND_API_URL=http://localhost:5030
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5030

# ==================== DATABASE ====================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai
DB_PASSWORD=kai123
DB_DATABASE=kai-demo
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flow:
REDIS_TTL=3600
REDIS_CLUSTER_MODE=false

# ==================== JWT (backend) ====================
JWT_SECRET=btppahdUToT90mq0LLJwv6PlXux+MV002v/yvlUVC/s=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=SkDbGP+JXzIejtU7ZSeVBxEy5/9yhUUQMEiW0jDOZPA=
