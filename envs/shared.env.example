# Kai — matriz de desarrollo (infra + manifiesto de deploy + secretos)
# Copiar a envs/shared.env para overrides locales (opcional; gitignored).
# Proyectada a cada app por envs/sync-dev-envs.sh + fragmentos *.example

# ==================== PLATAFORMA / DEPLOY ====================
# Vertical de producto
KAI_PRODUCT=kaistore
# lite | eshop | retail-full  (usado por dev-apps si KAI_DEPLOY_APPS está vacío)
KAI_DEPLOY_PROFILE=retail-full

# Módulos de ESTE despliegue (no por empresa en BD)
KAI_FEATURE_ESHOP=true
KAI_FEATURE_JEWELRY=true
KAI_FEATURE_MULTI_COMPANY=false
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true

# Apps a levantar en dev/deploy (coma-separado)
KAI_DEPLOY_APPS=backend,admin,pos,stock,eshop,mail

NODE_ENV=development
KAI_DEV_HOST=localhost

# Puertos (503x)
KAI_BACKEND_PORT=5030
KAI_ADMIN_PORT=5031
KAI_POS_PORT=5032
KAI_STOCK_PORT=5033
KAI_ESHOP_PORT=5034
KAI_MAIL_PORT=5040

# URLs derivadas (sync también las recalcula si cambias host/puertos)
KAI_BACKEND_URL=http://localhost:5030
BACKEND_API_URL=http://localhost:5030
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5030

# ==================== DATABASE ====================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai
DB_PASSWORD=kai123
DB_DATABASE=kai-demo
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flow:
REDIS_TTL=3600
REDIS_CLUSTER_MODE=false

