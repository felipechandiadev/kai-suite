# Perfil joyería + eShop (Joyarte). Copiar a envs/shared.env o fusionar manualmente.
KAI_PRODUCT=kaistore
KAI_DEPLOY_PROFILE=retail-full
KAI_FEATURE_ESHOP=true
KAI_FEATURE_JEWELRY=true
KAI_FEATURE_MULTI_COMPANY=false
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=false
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_APPS=backend,admin,pos,eshop,delivery,mail
NEXT_PUBLIC_ESHOP_STORE_SLUG=joyarte
