# Supermercado San Sebastián — sin eShop ni joyería.
KAI_PRODUCT=kaistore
KAI_DEPLOY_PROFILE=lite
KAI_FEATURE_ESHOP=false
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_MULTI_COMPANY=false
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=false
KAI_FEATURE_KAI_MAIL=false
KAI_DEPLOY_APPS=backend,admin,pos,landing

# Seed San Sebastián — contraseña certificado PFX (producción). No commitear shared.env.
SAN_SEBASTIAN_SII_PFX_PASSWORD=

# Actualizar tras seed (setup-san-sebastian-dev.sh lo hace automático)
NEXT_PUBLIC_COMPANY_ID_POS=
