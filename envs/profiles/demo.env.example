# Demo genérico Mi Empresa — multi-empresa en seed, sin joyería.
KAI_PRODUCT=kaistore
KAI_DEPLOY_PROFILE=all
KAI_FEATURE_ESHOP=true
KAI_FEATURE_JEWELRY=false
