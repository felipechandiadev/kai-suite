# Copiar a .env.local: cp .env.example .env.local
BACKEND_API_URL=http://localhost:4030
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4030

# Slug público de la empresa (settings.eShopPublicSlug) — una tienda por deploy
NEXT_PUBLIC_ESHOP_STORE_SLUG=demo

# Origen público de la tienda (Open Graph, compartir en redes)
NEXT_PUBLIC_ESHOP_SITE_URL=http://localhost:5034
# Producción: NEXT_PUBLIC_ESHOP_SITE_URL=https://tu-dominio.cl

NEXT_PUBLIC_APP_NAME=KaiStore eShop
NEXT_PUBLIC_APP_VERSION=0.1.0
