# Kai — puertos demo VPS (kaisuite.pro)
# Copiar líneas relevantes a envs/shared.env en el servidor o merge con la matriz local.
#
# DNS / reverse proxy → proceso Node en el host
#
# | Dominio                    | App           | Puerto |
# |----------------------------|---------------|--------|
# | core.demo.kaisuite.pro     | backend       | 5060   |
# | admin.demo.kaisuite.pro    | pwa-admin     | 5071   |
# | pos.demo.kaisuite.pro      | pwa-pos       | 5062   |
# | stock.demo.kaisuite.pro    | pwa-stock     | 5063   |
# | shop.demo.kaisuite.pro     | pwa-eshop     | 5064   |
# | delivery.demo.kaisuite.pro | kai-delivery  | 5065   |
# | store.kaisuite.pro         | landing       | 5066   |

KAI_BACKEND_PORT=5060
KAI_ADMIN_PORT=5071
KAI_POS_PORT=5062
KAI_STOCK_PORT=5063
KAI_ESHOP_PORT=5064
KAI_DELIVERY_PORT=5065
KAI_LANDING_PORT=5066
KAI_MAIL_PORT=5040

KAI_DEV_HOST=localhost
KAI_BACKEND_URL=http://localhost:5060
BACKEND_API_URL=http://localhost:5060
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5060

ADMIN_NEXTAUTH_URL=http://localhost:5071
POS_NEXTAUTH_URL=http://localhost:5062
STOCK_NEXTAUTH_URL=http://localhost:5063
NEXT_PUBLIC_ESHOP_SITE_URL=http://localhost:5064

