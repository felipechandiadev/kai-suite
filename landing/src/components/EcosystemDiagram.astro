---
import { ECOSYSTEM } from '../content/site';
import Reveal from './Reveal.astro';
---

<section class="section" id="ecosistema">
  <div class="wrap">
    <Reveal>
      <div class="section-header center">
        <span class="eyebrow">{ECOSYSTEM.eyebrow}</span>
        <h2>{ECOSYSTEM.title}</h2>
        <p class="lead">{ECOSYSTEM.intro}</p>
      </div>
    </Reveal>

    <Reveal>
      <ol class="eco-flow-vertical" aria-label="Flujo continuo de retail">
        {
          ECOSYSTEM.flowSteps.map((step, i) => (
            <li class="eco-flow-vertical__step">
              <div class="eco-flow-vertical__rail" aria-hidden="true">
                <span class="eco-flow-vertical__dot">
                  {step.icon === 'cart' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <circle cx="9" cy="20" r="1.5" fill="currentColor" />
                      <circle cx="18" cy="20" r="1.5" fill="currentColor" />
                      <path
                        d="M2 3h2l2.5 12h11l2-8H6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  {step.icon === 'cash' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <rect
                        x="3"
                        y="6"
                        width="18"
                        height="12"
                        rx="2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                      <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  )}
                  {step.icon === 'print' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <rect
                        x="6"
                        y="9"
                        width="12"
                        height="8"
                        rx="1"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                      <rect x="8" y="3" width="8" height="4" rx="0.5" fill="currentColor" opacity="0.3" />
                      <rect x="8" y="15" width="8" height="5" rx="0.5" fill="currentColor" opacity="0.2" />
                    </svg>
                  )}
                  {step.icon === 'prepare' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <rect
                        x="4"
                        y="3"
                        width="16"
                        height="18"
                        rx="2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                      <path
                        d="M8 8h8M8 12h8M8 16h5"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                      />
                    </svg>
                  )}
                  {step.icon === 'truck' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <path
                        d="M1 7h13v10H1zM14 10h4l3 3v4h-7V10z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linejoin="round"
                      />
                      <circle cx="5.5" cy="18.5" r="1.5" fill="currentColor" />
                      <circle cx="17.5" cy="18.5" r="1.5" fill="currentColor" />
                    </svg>
                  )}
                  {step.icon === 'boxes' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <path
                        d="M4 8l8-4 8 4v8l-8 4-8-4V8z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                      <path d="M12 4v16M4 8l8 4 8-4" stroke="currentColor" stroke-width="1.2" opacity="0.6" />
                    </svg>
                  )}
                  {step.icon === 'chart' && (
                    <svg viewBox="0 0 24 24" width="22" height="22">
                      <path d="M4 19V5M4 19h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                      <rect x="7" y="11" width="3" height="6" fill="currentColor" opacity="0.7" />
                      <rect x="12" y="8" width="3" height="9" fill="currentColor" opacity="0.85" />
                      <rect x="17" y="13" width="3" height="4" fill="currentColor" opacity="0.6" />
                    </svg>
                  )}
                </span>
              </div>
              <div class="eco-flow-vertical__copy">
                <strong>{step.label}</strong>
                <span>{step.sub}</span>
              </div>
              {i < ECOSYSTEM.flowSteps.length - 1 && (
                <span class="eco-flow-vertical__line" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </Reveal>
  </div>
</section>
