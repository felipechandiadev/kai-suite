---
/**
 * Product router: LANDING_PRODUCT=store|food (default store).
 * Baked at build/dev via astro.config vite.define.
 */
import StoreHome from '../store/pages/index.astro';
import FoodHome from '../food/pages/index.astro';

const product = import.meta.env.LANDING_PRODUCT === 'food' ? 'food' : 'store';
---

{product === 'food' ? <FoodHome /> : <StoreHome />}
