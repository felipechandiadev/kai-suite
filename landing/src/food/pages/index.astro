---
import Layout from '../../shared/layouts/Layout.astro';
import Reveal from '../../shared/components/Reveal.astro';
import FoodHeader from '../components/FoodHeader.astro';
import FoodFooter from '../components/FoodFooter.astro';
import OrderJourney from '../components/OrderJourney.astro';
import DeviceShowcases from '../components/DeviceShowcases.astro';
import RolesGrid from '../components/RolesGrid.astro';
import Differentiators from '../components/Differentiators.astro';
import AppsBrief from '../components/AppsBrief.astro';
import { CTA, HERO, SITE } from '../content/site';
import '../styles/food.css';
---

<Layout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} themeClass="theme-food">
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
    rel="stylesheet"
  />

  <div class="food-atmosphere" aria-hidden="true"></div>
  <FoodHeader />

  <main>
    <section class="section food-hero" id="intro">
      <div class="wrap food-hero__grid">
        <Reveal>
          <div class="food-hero__copy">
            <p class="hero-brand">{HERO.brand}</p>
            <h1>{HERO.title}</h1>
            <p class="lead">{HERO.subtitle}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={HERO.primaryCta.href}>{HERO.primaryCta.label}</a>
            </div>
          </div>
        </Reveal>
        <Reveal>
          <figure class="food-hero__visual">
            <img
              src="/food/screenshots/hero-food.jpg"
              alt="KaiFood en el local: mesero con móvil, cocina con KDS, caja POS y Board en TV, conectados en tiempo real"
              width="1024"
              height="683"
              loading="eager"
              decoding="async"
            />
          </figure>
        </Reveal>
      </div>
    </section>

    <OrderJourney />
    <DeviceShowcases />
    <RolesGrid />
    <Differentiators />
    <AppsBrief />

    <section class="section food-cta" id="demo">
      <div class="wrap">
        <Reveal>
          <div class="food-cta__panel surface">
            <h2>{CTA.title}</h2>
            <p class="lead">{CTA.body}</p>
            <div class="cta-actions">
              <a class="btn btn-primary" href={CTA.primary.href}>{CTA.primary.label}</a>
              <a class="btn btn-ghost" href={CTA.secondary.href}>{CTA.secondary.label}</a>
            </div>
          </div>
        </Reveal>
      </div>
    </section>
  </main>

  <FoodFooter />
</Layout>
