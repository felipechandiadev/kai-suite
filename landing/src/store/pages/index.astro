---
/**
 * KaiStore landing page (product = store).
 */
import Layout from '../../shared/layouts/Layout.astro';
import Reveal from '../../shared/components/Reveal.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LayersStack from '../components/LayersStack.astro';
import EcosystemDiagram from '../components/EcosystemDiagram.astro';
import StickyPillars from '../components/StickyPillars.astro';
import ModulesGrid from '../components/ModulesGrid.astro';
import IndicatorsSection from '../components/IndicatorsSection.astro';
import LogoShowcase from '../components/LogoShowcase.astro';
import SiiCompliance from '../components/SiiCompliance.astro';
import MultiEmpresaSection from '../components/MultiEmpresaSection.astro';
import BentoPlatform from '../components/BentoPlatform.astro';
import HeroVisual from '../components/HeroVisual.astro';
import { CTA, HERO, SITE } from '../content/site';
import '../styles/store.css';
---

<Layout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} themeClass="theme-store">
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <div class="hero-glow" aria-hidden="true"></div>
  <Header />

  <main>
    <section class="section hero" id="intro">
      <div class="wrap hero-grid">
        <Reveal>
          <div class="hero-copy">
            <p class="hero-brand">{HERO.brand}</p>
            <h1>{HERO.title}</h1>
            <p class="lead">{HERO.subtitle}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={HERO.secondaryCta.href}>{HERO.secondaryCta.label}</a>
            </div>
          </div>
        </Reveal>

        <Reveal>
          <HeroVisual />
        </Reveal>
      </div>
    </section>

    <LogoShowcase />
    <LayersStack />
    <MultiEmpresaSection />
    <EcosystemDiagram />
    <StickyPillars />
    <ModulesGrid />
    <IndicatorsSection />
    <SiiCompliance />
    <BentoPlatform />

    <section class="cta-section" id="demo">
      <div class="wrap">
        <Reveal>
          <h2>{CTA.title}</h2>
          <p class="lead">{CTA.body}</p>
          <div class="cta-actions">
            <a class="btn btn-primary" href={CTA.secondary.href}>{CTA.secondary.label}</a>
          </div>
        </Reveal>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
