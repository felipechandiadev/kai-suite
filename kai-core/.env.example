# Flow Store Backend — plantilla (copiar a .env y ajustar)
# Variables validadas en: src/config/config.schema.ts

# ==================== APPLICATION ====================
NODE_ENV=development
PORT=5060
API_PREFIX=api
# Modalidad de producto: kaistore | kaifood | kaiservices | kaisuite
KAI_PRODUCT=kaisuite

# ==================== DATABASE ====================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
# Usuario local (Homebrew / nativo): kai. Provisionar: npm run setup:postgres
# No usar "postgres" en Mac Homebrew: ese rol normalmente no existe.
# Docker solo si KAI_DEV_POSTGRES=docker (compose del repo).
DB_USERNAME=kai
DB_PASSWORD=kai123
DB_DATABASE=kai-demo
# Local: true sincroniza esquema con entidades (sin migraciones). Producción: false + migraciones.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# ==================== REDIS CACHE ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flow:
REDIS_TTL=3600
REDIS_CLUSTER_MODE=false

# ==================== JWT AUTHENTICATION ====================
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ==================== CORS ====================
# * | all = cualquier origen solo si CORS_CREDENTIALS=false (sin cookies en fetch).
# Con credentials: include en el front: CORS_CREDENTIALS=true y orígenes explícitos (no *).
# Lista: http://localhost:5071,http://127.0.0.1:5071 (admin); pos/stock/eshop/delivery: 5062–5065
CORS_ORIGIN=http://localhost:5071,http://127.0.0.1:5071,http://localhost:5062,http://127.0.0.1:5062,http://localhost:5063,http://127.0.0.1:5063,http://localhost:5064,http://127.0.0.1:5064,http://localhost:5065,http://127.0.0.1:5065
CORS_CREDENTIALS=true

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ==================== METRICS & MONITORING ====================
METRICS_ENABLED=true
METRICS_PREFIX=flow_backend
HEALTH_CHECK_ENABLED=true

# ==================== EXTERNAL APIs ====================
GOLD_API_URL=
GOLD_API_KEY=

# ==================== EMAIL ====================
SMTP_HOST=
# SMTP (opcional; Mailpit dev: localhost:1025)
# SMTP_HOST=localhost
# SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ==================== FILE UPLOAD ====================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# ==================== MULTIMEDIA STORAGE ====================
STORAGE_STRATEGY=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
LOCAL_STORAGE_PATH=./public/uploads
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,application/pdf
MEDIA_PUBLIC_BASE_PATH=/multimedia/files

# ==================== SECURITY ====================
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==================== BUSINESS RULES ====================
MAX_TRANSACTION_LINES=100
DEFAULT_CURRENCY=COP
TIMEZONE=America/Bogota

# ==================== FEATURE FLAGS ====================
ENABLE_SWAGGER=true
ENABLE_CORS=true
ENABLE_HEALTH_CHECK=true
ENABLE_METRICS=true
ENABLE_CACHE=true
# Checkout eShop v2: CUSTOMER_ORDER / BACKORDER en lugar de SALE ficticia
ESHOP_CHECKOUT_V2=true
# URL pública del eShop (enlaces en correos de verificación de cuenta)
ESHOP_PUBLIC_SITE_URL=http://localhost:5064

# URL pública del backend para webhooks MP (dev: http://localhost:5060; prod/ngrok: https://...)
MP_WEBHOOK_BASE_URL=http://localhost:5060

# Mercado Pago — webhook (clave en panel MP > Webhooks > Configurar notificaciones)
# URL dev con ngrok: https://<subdominio>.ngrok-free.app/api/webhooks/mercado-pago
MP_WEBHOOK_SECRET=

# ==================== KAI MAIL (microservicio opcional) ====================
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_API_KEY=dev-kai-mail-key

# Stock realtime: re-emite por WebSocket saldos fuera de umbral (ms). 0 = desactivado. Default 30 min.
STOCK_THRESHOLD_SWEEP_MS=1800000
