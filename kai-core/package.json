{
  "name": "kai-core",
  "version": "1.3.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run build --prefix ../packages/fiscal-ted && npm run build --prefix ../packages/chile-catalogs",
    "prestart": "npm run build --prefix ../packages/fiscal-ted && npm run build --prefix ../packages/chile-catalogs",
    "prestart:dev": "npm run build --prefix ../packages/fiscal-ted && npm run build --prefix ../packages/chile-catalogs",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:run": "npm run build && typeorm migration:run -d dist/config/data-source.js --transaction each",
    "migration:baseline": "npm run build && node node_modules/ts-node/dist/bin.js -r tsconfig-paths/register scripts/baseline-migrations.ts",
    "eshop:enable-demo": "ts-node -r tsconfig-paths/register src/scripts/enable-eshop-demo.ts",
    "fiscal:try-pfx-password": "ts-node -r tsconfig-paths/register src/scripts/try-pfx-password.ts",
    "fiscal:export-ss-seed": "ts-node -r tsconfig-paths/register src/scripts/export-san-sebastian-fiscal-seed.ts",
    "fiscal:import-ss-to-company": "npm run import-fiscal-to-company --prefix ../seeds"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@kai/chile-catalogs": "file:../packages/chile-catalogs",
    "@kai/fiscal-ted": "file:../packages/fiscal-ted",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.19",
    "@types/redis": "^4.0.10",
    "@types/winston": "^2.4.4",
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "fast-xml-parser": "^5.9.3",
    "form-data": "^4.0.6",
    "ioredis": "^5.9.3",
    "joi": "^18.1.2",
    "libxmljs2": "^0.37.0",
    "moment-timezone": "^0.6.0",
    "mysql2": "^3.16.3",
    "node-forge": "^1.4.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "tsc-alias": "^1.8.16",
    "typeorm": "^0.3.28",
    "typescript": "^5.7.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/node-forge": "^1.3.14",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "playwright": "^1.52.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1"
    }
  }
}
